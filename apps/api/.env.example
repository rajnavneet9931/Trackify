# Copy to .env (git-ignored). Never commit real credentials.

# ─── Runtime ──────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────
# Connection used by the running API. Pick one:
#   Docker Compose: postgresql://trackify:trackify@localhost:5432/trackify?schema=public
#   Local install:  postgresql://<user>:<password>@localhost:5432/trackify
#   Hosted (TLS):   postgresql://<user>:<password>@<host>/<db>?sslmode=verify-full
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://trackify:trackify@localhost:5432/trackify?schema=public

# Optional, Prisma CLI only (migrate/studio). Set when DATABASE_URL goes through a
# transaction-mode pooler (PgBouncer, Neon "-pooler" host, Supabase :6543), which
# Prisma Migrate cannot use. Falls back to DATABASE_URL when empty.
DIRECT_DATABASE_URL=

# Connections per API process. Total = instances × DATABASE_POOL_MAX; keep it
# below the server's max_connections or use a pooler when scaling out.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Budget for the /health/ready database check (allows serverless cold starts).
HEALTH_DB_TIMEOUT_MS=5000
# In-process task reminder processor interval; 0 disables it (e.g. on extra instances).
REMINDER_POLL_INTERVAL_MS=30000

# ─── HTTP / security ─────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops (0 = none). Required for correct client IPs behind a load balancer.
TRUST_PROXY=0
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter per-IP limit for POST /auth/register (each attempt costs an Argon2 hash).
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10
# Login: all attempts per IP, and failed attempts per account (normalized email), per window.
# In-memory counters: with N instances the effective limit is up to N × these values.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
LOGIN_ACCOUNT_RATE_LIMIT_MAX=5

# ─── Sessions ─────────────────────────────────────────────
# Absolute session lifetime in hours (1–720).
SESSION_TTL_HOURS=168
# Secure cookies (HTTPS only). Leave unset: defaults to true in production, false otherwise.
# Production refuses to start with false.
SESSION_COOKIE_SECURE=
# strict | lax | none. Keep strict when the SPA and API are on the same site; none (cross-site
# hosting) requires SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=strict

# ─── Invitations ──────────────────────────────────────────
# Invitation lifetime in hours (1–720).
INVITATION_TTL_HOURS=168
# DEVELOPMENT ONLY: return an accept link (containing the raw token) in the create response,
# because no email delivery is configured. Leave unset: on in development, off otherwise.
# Startup fails if set to true in production.
INVITATION_DEV_LINKS=
# Invitations one user may create per window.
INVITATION_RATE_LIMIT_WINDOW_MS=3600000
INVITATION_RATE_LIMIT_MAX=20
