# Copy to .env.test (git-ignored) to enable the real-database integration tests.
# Must be a SEPARATE database from DATABASE_URL in .env — the test run refuses
# to start if both point at the same database. Registration tests insert rows under a
# per-run email domain and delete them afterwards.
#   Docker Compose: postgresql://trackify:trackify@localhost:5432/trackify_test
TEST_DATABASE_URL=

# Optional: direct (non-pooled) URL used by `npm run db:test:deploy` to apply migrations.
TEST_DIRECT_DATABASE_URL=
