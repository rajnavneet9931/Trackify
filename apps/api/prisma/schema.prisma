// Trackify database schema.
// Domain models are introduced feature-by-feature.
// Connection URLs are configured in prisma.config.ts (Prisma 7+).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Partial unique index on workspace_invitations (one PENDING invite per
  // workspace + email). Preview in Prisma 7.10; keeps the index in the schema
  // so migrations and drift checks know about it.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// A registered account. Contains only what registration needs; roles,
/// profiles and memberships are added by later features.
model User {
  /// UUIDv7: generated by Prisma, time-ordered for index locality.
  id                String                @id @default(uuid(7)) @db.Uuid
  /// Trimmed and lower-cased by the application before every write and lookup.
  email             String                @unique(map: "users_email_key") @db.VarChar(254)
  /// Argon2id encoded hash (PHC string). Never the plaintext password.
  passwordHash      String                @map("password_hash")
  /// Optional display name: NFC-normalized, trimmed, 1–100 characters (validated by the API).
  name              String?               @db.VarChar(100)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  memberships       WorkspaceMember[]
  invitationsSent   WorkspaceInvitation[]
  projectsCreated   Project[]
  tasksCreated      Task[]                @relation("TaskCreator")
  tasksAssigned     Task[]                @relation("TaskAssignee")
  taskComments      TaskComment[]
  taskActivities    TaskActivity[]
  remindersReceived TaskReminder[]
  notifications     Notification[]        @relation("NotificationRecipient")
  notificationsSent Notification[]        @relation("NotificationActor")
  settings          UserSettings?

  @@map("users")
}

/// A server-side login session. The browser holds an opaque random token in an
/// HttpOnly cookie; only its SHA-256 digest is stored, so a database leak does
/// not yield usable session cookies. Deleting a row revokes the session.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256(token), 32 bytes. The token itself is never stored.
  tokenHash Bytes    @unique(map: "sessions_token_hash_key") @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute expiry; sessions are rejected after this instant.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

/// Role of a user within one workspace. A Postgres enum, so the database
/// rejects any other value.
enum WorkspaceRole {
  OWNER
  MEMBER

  @@map("workspace_role")
}

/// A team's shared space. Who belongs to it (and with which role) lives in
/// WorkspaceMember; there is deliberately no owner column to keep in sync.
model Workspace {
  id            String                @id @default(uuid(7)) @db.Uuid
  /// Trimmed, NFC-normalized, 1–100 characters (validated by the API).
  name          String                @db.VarChar(100)
  /// Optional; trimmed, at most 2,000 characters; empty is stored as NULL (validated by the API).
  description   String?               @db.VarChar(2000)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  projects      Project[]
  notifications Notification[]

  @@map("workspaces")
}

/// Membership of a user in a workspace.
/// - Deleting a workspace deletes its memberships (Cascade).
/// - Deleting a user who still belongs to a workspace is refused (Restrict), so a
///   workspace can never silently lose its owner; account deletion must first
///   transfer or delete ownership explicitly.
model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// One membership per user per workspace; also serves lookups by workspace.
  @@unique([workspaceId, userId], map: "workspace_members_workspace_id_user_id_key")
  /// Lookups by user ("my workspaces").
  @@index([userId], map: "workspace_members_user_id_idx")
  @@map("workspace_members")
}

/// Lifecycle of an invitation. Only PENDING invitations can be accepted,
/// declined or revoked; every other state is final.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

/// An invitation for an existing user (by normalized email) to join a
/// workspace as MEMBER. The invitee proves possession of a random token; only
/// its SHA-256 digest is stored.
/// - Deleting the workspace deletes its invitations (Cascade).
/// - Deleting the inviter's account deletes the invitations they sent (Cascade):
///   an invitation must not outlive the person vouching for it.
model WorkspaceInvitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  inviterId   String           @map("inviter_id") @db.Uuid
  /// Trimmed and lower-cased, exactly like users.email.
  email       String           @db.VarChar(254)
  /// SHA-256(token), 32 bytes. The token itself is never stored.
  tokenHash   Bytes            @unique(map: "workspace_invitations_token_hash_key") @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  /// At most one PENDING invitation per workspace and email, enforced by
  /// PostgreSQL even under concurrent requests. Also serves lookups by
  /// (workspace, email).
  @@unique([workspaceId, email], map: "workspace_invitations_one_pending_key", where: { status: "PENDING" })
  /// Owner lookups by workspace, and the FK from workspaces.
  @@index([workspaceId], map: "workspace_invitations_workspace_id_idx")
  /// FK from users (makes the inviter cascade an index scan).
  @@index([inviterId], map: "workspace_invitations_inviter_id_idx")
  @@map("workspace_invitations")
}

/// Lifecycle of a project. New projects are always ACTIVE (set by the server).
enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@map("project_status")
}

/// A project belongs to exactly one workspace.
/// - Deleting the workspace deletes its projects (Cascade), like its memberships
///   and invitations.
/// - Deleting the creator's account is refused while they have created projects
///   (Restrict): the authorship record is never silently lost. A future
///   account-deletion feature must reassign or anonymize authorship explicitly.
model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  /// NFC-normalized, trimmed, 1–120 characters (validated by the API).
  name        String        @db.VarChar(120)
  /// Optional; trimmed, at most 2,000 characters; empty is stored as NULL.
  description String?       @db.VarChar(2000)
  status      ProjectStatus @default(ACTIVE)
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  /// Workspace-scoped lookups and the cascade from workspaces.
  @@index([workspaceId], map: "projects_workspace_id_idx")
  /// Keyset listing: WHERE workspace_id = ? ORDER BY created_at DESC, id DESC.
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)], map: "projects_workspace_id_created_at_id_idx")
  /// FK from users: lets the RESTRICT check on user deletion use an index.
  @@index([createdById], map: "projects_created_by_id_idx")
  @@map("projects")
}

/// Workflow state of a task. New tasks are always TODO (set by the server).
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

/// A task belongs to exactly one project (and through it to one workspace).
/// - Deleting a project at the database level deletes its tasks (Cascade), so
///   deleting a workspace removes everything in it, like its projects. The API
///   never deletes a project that still has tasks (409): task data is never
///   lost as a side effect of a project deletion in the product.
/// - Deleting the creator's account is refused while they have created tasks
///   (Restrict), like projects: authorship is never silently lost.
/// - At most one assignee, who must be a member of the task's workspace. The
///   API checks membership (row locked FOR SHARE) when assigning, and member
///   removal unassigns that user's tasks in that workspace in the same
///   transaction. Deleting an assignee's account clears the assignment
///   (SetNull): an assignment is current state, not audit data.
model Task {
  id          String         @id @default(uuid(7)) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  /// NFC-normalized, trimmed, 1–200 characters (validated by the API).
  title       String         @db.VarChar(200)
  /// Optional; trimmed, at most 5,000 characters; empty is stored as NULL.
  description String?        @db.VarChar(5000)
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  createdById String         @map("created_by_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  /// Deadline (UTC). Optional.
  dueDate     DateTime?      @map("due_date") @db.Timestamptz(3)
  /// When to remind (UTC). Requires a due date and is never after it (validated by the API).
  reminderAt  DateTime?      @map("reminder_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  activities  TaskActivity[]
  reminders   TaskReminder[]

  /// Keyset listing (WHERE project_id = ? ORDER BY created_at DESC, id DESC).
  /// Its leading column also serves every lookup by project and the cascade,
  /// so there is no separate single-column project_id index.
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "tasks_project_id_created_at_id_idx")
  /// FK from users: lets the RESTRICT check on user deletion use an index.
  @@index([createdById], map: "tasks_created_by_id_idx")
  /// Member removal unassigns by assignee; also serves the SetNull on user deletion.
  @@index([assigneeId], map: "tasks_assignee_id_idx")
  /// Queries by deadline (overdue / due soon).
  @@index([dueDate], map: "tasks_due_date_idx")
  @@map("tasks")
}

/// A comment in a task's discussion.
/// - Deleting the task deletes its comments (Cascade), so deleting a workspace
///   still removes everything in it. There is no task deletion yet, and project
///   deletion is refused while tasks exist, so the product never drops comments.
/// - Deleting the author's account is refused while they have comments
///   (Restrict), like task and project creators: authorship is never silently
///   lost. Removing the author from the workspace keeps their comments.
model TaskComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  /// The author: always the authenticated user, never taken from a request body.
  userId    String   @map("user_id") @db.Uuid
  /// NFC-normalized, trimmed, 1–5,000 characters (validated by the API).
  content   String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Chronological keyset listing (WHERE task_id = ? ORDER BY created_at, id);
  /// also serves lookups by task and the cascade from tasks.
  @@index([taskId, createdAt, id], map: "task_comments_task_id_created_at_id_idx")
  /// FK from users: lets the RESTRICT check on user deletion use an index.
  @@index([userId], map: "task_comments_user_id_idx")
  @@map("task_comments")
}

/// What happened in a task activity entry.
enum TaskActivityType {
  TASK_CREATED
  TASK_UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED

  @@map("task_activity_type")
}

/// An immutable entry in a task's activity history (audit trail), written in
/// the same transaction as the operation it records. There is no API to
/// create, edit or delete entries, and no updated_at.
/// - Deleting the task deletes its history (Cascade), like its comments, so
///   deleting a workspace removes everything in it.
/// - Deleting the actor's account keeps the entry but clears the actor
///   (SetNull): the history survives, and it never blocks account deletion.
/// - `metadata` holds small, typed, validated details (previous/new values,
///   user and comment IDs); never comment text or any credential.
model TaskActivity {
  id        String           @id @default(uuid(7)) @db.Uuid
  taskId    String           @map("task_id") @db.Uuid
  /// The actor: always the authenticated user; NULL once their account is deleted.
  userId    String?          @map("user_id") @db.Uuid
  type      TaskActivityType
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Chronological keyset listing (WHERE task_id = ? ORDER BY created_at, id);
  /// also serves lookups by task and the cascade from tasks.
  @@index([taskId, createdAt, id], map: "task_activities_task_id_created_at_id_idx")
  /// FK from users: lets the SET NULL on user deletion use an index.
  @@index([userId], map: "task_activities_user_id_idx")
  @@map("task_activities")
}

/// Delivery state of a scheduled task reminder.
enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED

  @@map("reminder_status")
}

/// A scheduled in-app reminder for a task, processed by the API's background
/// reminder processor. At most one PENDING reminder per task (partial unique
/// index); changing or removing a task's reminder cancels the pending row (and
/// schedules a new one) in the same transaction. A SENT row is the in-app
/// notification for its recipient.
/// - Deleting the task deletes its reminders (Cascade).
/// - The recipient is resolved at delivery time (assignee, else creator, if
///   still a member) and recorded; deleting that account deletes the
///   notifications it received (Cascade).
model TaskReminder {
  id          String         @id @default(uuid(7)) @db.Uuid
  taskId      String         @map("task_id") @db.Uuid
  /// Set when the reminder is delivered.
  recipientId String?        @map("recipient_id") @db.Uuid
  remindAt    DateTime       @map("remind_at") @db.Timestamptz(3)
  status      ReminderStatus @default(PENDING)
  /// Delivery attempts that failed with an error (retried up to a limit).
  attempts    Int            @default(0)
  /// Why delivery failed or was cancelled; never contains credentials.
  lastError   String?        @map("last_error") @db.VarChar(500)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(3)
  readAt      DateTime?      @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient   User?          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  /// At most one pending reminder per task, even under concurrent edits.
  @@unique([taskId], map: "task_reminders_one_pending_key", where: { status: "PENDING" })
  /// The processor's query: pending reminders that are due, oldest first.
  @@index([remindAt], map: "task_reminders_pending_due_idx", where: { status: "PENDING" })
  /// A user's in-app inbox (newest first); also serves the cascade from users.
  @@index([recipientId, sentAt(sort: Desc), id(sort: Desc)], map: "task_reminders_inbox_idx")
  /// Lookups by task (latest reminder status) and the cascade from tasks.
  @@index([taskId, createdAt], map: "task_reminders_task_id_created_at_idx")
  @@map("task_reminders")
}

enum NotificationType {
  /// The recipient became a task's assignee (assigned or reassigned).
  TASK_ASSIGNED
  /// Someone else commented on a task the recipient is assigned to or created.
  TASK_COMMENTED
  /// A scheduled task reminder came due (the recipient's due-date notice).
  TASK_REMINDER

  @@map("notification_type")
}

enum NotificationResourceType {
  TASK
  PROJECT
  WORKSPACE

  @@map("notification_resource_type")
}

/// One in-app notification for one user. Written inside the transaction of
/// the operation it describes (assignment, comment, reminder delivery).
model Notification {
  id           String                   @id @default(uuid(7)) @db.Uuid
  recipientId  String                   @map("recipient_id") @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  /// Who caused it: NULL for system events (reminders) or once the account is deleted.
  actorId      String?                  @map("actor_id") @db.Uuid
  type         NotificationType
  /// Short, fixed wording per type (at most 120 characters).
  title        String                   @db.VarChar(120)
  /// Readable sentence; may quote the task title, never comment text or descriptions.
  message      String                   @db.VarChar(500)
  resourceType NotificationResourceType @map("resource_type")
  /// The task, project or workspace it is about. Deliberately no foreign key
  /// (polymorphic); a missing resource is handled when reading.
  resourceId   String                   @map("resource_id") @db.Uuid
  /// Identifies the event (e.g. "comment:<id>"); unique per recipient, so an
  /// event never notifies the same user twice.
  eventKey     String                   @map("event_key") @db.VarChar(200)
  isRead       Boolean                  @default(false) @map("is_read")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt       DateTime?                @map("read_at") @db.Timestamptz(3)
  recipient    User                     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?                    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Duplicate prevention (INSERT … ON CONFLICT DO NOTHING); also serves the cascade from users.
  @@unique([recipientId, eventKey], map: "notifications_recipient_event_key")
  /// The inbox: WHERE recipient_id = ? ORDER BY created_at DESC, id DESC.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  /// Unread count and "unread only": small, because read rows drop out.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_unread_idx", where: { isRead: false })
  /// Cascade from workspaces and per-workspace queries.
  @@index([workspaceId, createdAt], map: "notifications_workspace_id_created_at_idx")
  /// FK from users (actor): lets the SET NULL on user deletion use an index.
  @@index([actorId], map: "notifications_actor_id_idx")
  @@map("notifications")
}

/// How dates are written in the web app. LOCALE follows the browser's language.
enum DateFormat {
  LOCALE
  /// 2026-11-04
  ISO
  /// 04/11/2026
  DMY
  /// 11/04/2026
  MDY

  @@map("date_format")
}

/// A user's preferences. Optional: a missing row means every default applies.
model UserSettings {
  userId              String     @id @map("user_id") @db.Uuid
  /// IANA time zone (validated by the API); NULL = the device's time zone.
  timeZone            String?    @map("time_zone") @db.VarChar(64)
  dateFormat          DateFormat @default(LOCALE) @map("date_format")
  /// In-app notification types the user wants (all on by default).
  notifyTaskAssigned  Boolean    @default(true) @map("notify_task_assigned")
  notifyTaskCommented Boolean    @default(true) @map("notify_task_commented")
  notifyTaskReminder  Boolean    @default(true) @map("notify_task_reminder")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
