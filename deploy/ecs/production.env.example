# Set these as ECS task environment variables (not secrets).
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
INVITATION_DEV_LINKS=false
DATABASE_POOL_MAX=5
# DATABASE_URL must be injected as an ECS secret from Secrets Manager.
# DIRECT_DATABASE_URL is only needed by the one-off migration task if different.
